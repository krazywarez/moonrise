{
  "name": "moonrise-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/5 * * * *", "*/10 * * * *", "7 */2 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moonrise",
      "database_id": "54a0c50d-2150-47ae-aa22-449e8204ad7b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APNS_KEY_ID": "644XS4F2RG",
    "APNS_TEAM_ID": "ZCNAX3VL9D",
    "APNS_TOPIC": "sh.krz.moonrise",
    "APNS_MANAGE_CHANNELS": "1"
  }
  // Secret: APNS_KEY (.p8 contents), set with `wrangler secret put APNS_KEY`.
}
